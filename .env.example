# Node.js API
HOST=127.0.0.1
PORT=5055
DATABASE_FILE=backend/data/contech.sqlite
CORS_ORIGIN=http://localhost:5173

# Company Office files. Relative paths are resolved from this project folder.
# The defaults below point to C:\Users\nehru\OneDrive\Desktop\Files on this machine.
WORD_TEMPLATE_DIR=../Files
EXCEL_FILES_DIR=../Files/ExcelFiles

# The initial administrator is created only when the users table is empty.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin@12345
INITIAL_ADMIN_FULLNAME=System Administrator

# Set NODE_ENV=production behind HTTPS in production.
NODE_ENV=development
